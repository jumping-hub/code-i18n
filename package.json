{
  "name": "code-i18n-agent",
  "version": "0.1.3",
  "description": "智能体：自动将代码项目国际化的扫描-分类-提取-翻译-替换-验证管线（不限于 ERP，适配 Vue/React/TS/JS/HTML）",
  "type": "commonjs",
  "main": "dist/cli.js",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "code-i18n-agent": "dist/cli.js",
    "code-i18n-mcp": "dist/mcp-server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build && node tests/run-all.js && node tests/mcp-smoke.js",
    "test": "npm run build && node tests/run-all.js",
    "test:only": "node tests/run-all.js",
    "test:mcp": "npm run build && node tests/mcp-smoke.js",
    "demo": "npm run build && node dist/cli.js run --project fixtures/erp-demo --yes",
    "mcp": "node dist/mcp-server.js"
  },
  "dependencies": {
    "typescript": "~5.7.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "agent",
    "ast",
    "mcp",
    "code"
  ],
  "license": "MIT"
}
